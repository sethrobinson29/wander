# DigitalOcean Container Registry name (e.g. wander-registry)
DO_REGISTRY=your-registry-name

# Database — DO Managed PostgreSQL connection string
ConnectionStrings__Default=Host=db-host;Port=25060;Database=wander;Username=wander;Password=...;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=18

# JWT
Jwt__Key=your-super-secret-key-must-be-32-chars-minimum
Jwt__Issuer=wander-api
Jwt__Audience=wander-client

# Admin seed credentials
Admin__Email=admin@yourdomain.com
Admin__Password=strong-password-here

# CORS — must match your production domain
Cors__AllowedOrigins__0=https://wander.sethrobinson29.com
