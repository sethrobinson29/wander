<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Leave Playtest?</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2">
            Your board state, hand, life total, and turn count will be lost.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm">Leave</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    void Cancel() => MudDialog.Cancel();
    void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
