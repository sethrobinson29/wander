<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reset Playtest?</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2">
            This reshuffles the deck and deals a new opening hand. Life, turn count, mana pool,
            and all card positions/counters will be cleared. This cannot be undone.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm">Reset</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    void Cancel() => MudDialog.Cancel();
    void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
